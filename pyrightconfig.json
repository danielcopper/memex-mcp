{
  "pythonVersion": "3.12",
  // Every basedpyright rule is on; `mise run typecheck` fails on a warning too.
  "typeCheckingMode": "recommended",
  "include": ["memex_mcp", "scripts", "tests"],
  "exclude": [".venv", "build", ".claude"],
  "reportMissingModuleSource": "none",
  // Off: the results dropped here are dropped by design (cursors of SQL writes, git run for its
  // effect, calls inside pytest.raises); unawaited coroutines stay errors (reportUnusedCoroutine).
  "reportUnusedCallResult": "none"
}
